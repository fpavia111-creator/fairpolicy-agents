{
  "name": "fairpolicy-agents",
  "private": true,
  "description": "Fairpolicy: insurance agency and brokerage back-office agents (fairpolicy-core plus 30 agents, one back-office job each).",
  "license": "MIT",
  "workspaces": [
    "vendor/fair-agent-core",
    "packages/fairpolicy-core",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "hostile": "node scripts/hostile-inputs.mjs",
    "hostile:args": "node scripts/hostile-inputs.mjs --args",
    "release:check": "node scripts/release-check.mjs",
    "release:check:offline": "node scripts/release-check.mjs --offline",
    "bench": "node scripts/bench.mjs",
    "plugin": "node scripts/plugin-files.mjs",
    "plugin:check": "node scripts/plugin-files.mjs --check",
    "fixtures": "node scripts/make-fixtures.mjs",
    "mcp:check": "node scripts/mcp-conformance.mjs",
    "intl": "node scripts/intl-check.mjs",
    "readme": "node scripts/readme-heads.mjs && node scripts/readme-sections.mjs",
    "readme:check": "node scripts/readme-sections.mjs --check",
    "evals": "node scripts/run-all-evals.mjs",
    "evals:safety": "node scripts/eval-safety.mjs",
    "samples": "node scripts/sample-reports.mjs",
    "readme:i18n": "node scripts/readme-i18n.mjs",
    "accuracy": "node scripts/accuracy.mjs --record",
    "accuracy:write": "node scripts/accuracy.mjs --write",
    "model-view": "node scripts/model-view.mjs",
    "realdata": "node scripts/realdata.mjs --download",
    "realdata:offline": "node scripts/realdata.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
