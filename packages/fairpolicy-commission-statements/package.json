{
  "name": "fairpolicy-commission-statements",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairpolicy-commission-statements",
  "description": "Checks every line of your carriers' commission statements against the commission you expect on that policy (your schedule by carrier, line and new or renewal), and lists underpaid, overpaid, duplicate and unmatched lines. Drafts a commission inquiry; never posts or sends.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-commission-statements": "bin/fairpolicy-commission-statements.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-commission-statements.js demo",
    "eval": "node bin/fairpolicy-commission-statements.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-commission-statements"
  },
  "homepage": "https://github.com/fpavia111-creator/fairpolicy-agents/tree/master/packages/fairpolicy-commission-statements#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "insurance",
    "insurance-agency",
    "agency-management",
    "fairpolicy",
    "commissions",
    "commission-statements",
    "direct-bill",
    "reconciliation"
  ]
}
