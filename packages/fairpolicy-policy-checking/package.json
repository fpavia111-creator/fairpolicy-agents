{
  "name": "fairpolicy-policy-checking",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairpolicy-policy-checking",
  "description": "Checks each issued policy against what was bound, coverage by coverage: missing coverages, lower limits, higher deductibles, different premium or dates, and binders with nothing issued. Never binds or endorses.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-policy-checking": "bin/fairpolicy-policy-checking.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-policy-checking.js demo",
    "eval": "node bin/fairpolicy-policy-checking.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-policy-checking"
  },
  "homepage": "https://github.com/fpavia111-creator/fairpolicy-agents/tree/main/packages/fairpolicy-policy-checking#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "insurance",
    "insurance-agency",
    "agency-management",
    "fairpolicy",
    "policy-checking",
    "binders",
    "errors-and-omissions",
    "coverage-review"
  ]
}
