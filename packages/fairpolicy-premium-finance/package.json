    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-premium-finance": "bin/fairpolicy-premium-finance.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-premium-finance.js demo",
    "eval": "node bin/fairpolicy-premium-finance.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.1.0"
