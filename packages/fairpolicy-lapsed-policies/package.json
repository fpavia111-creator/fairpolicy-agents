{
  "name": "fairpolicy-lapsed-policies",
  "version": "0.1.0",
  "description": "Finds policies cancelled, lapsed or expired in the last 90 days: non-payment cancellations still inside a reinstatement window, clients with no replacement policy, and policies shown active but past expiration. Never reinstates or advises.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-lapsed-policies": "bin/fairpolicy-lapsed-policies.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-lapsed-policies.js demo",
    "eval": "node bin/fairpolicy-lapsed-policies.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-lapsed-policies"
  },
  "homepage": "https://github.com/fpavia111-creator/fairpolicy-agents/tree/main/packages/fairpolicy-lapsed-policies#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "insurance",
    "insurance-agency",
    "agency-management",
    "fairpolicy",
    "lapsed-policies",
    "cancellations",
    "non-payment",
    "retention"
  ]
}
