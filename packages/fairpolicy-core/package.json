{
  "name": "fairpolicy-core",
  "version": "0.1.0",
  "description": "Shared core for the Fairpolicy insurance agency agents: pinned-model pack manifests, allow/ask/block policy, Review/Assist/Auto modes with caps and a kill switch, hash-chained audit logs, client-data masking, insurance export readers, a zero-dependency stdio MCP server and fixture-based evals.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./testkit": "./src/testkit.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-approve": "bin/fairpolicy-approve.js",
    "fairpolicy-verify-log": "bin/fairpolicy-verify-log.js",
    "fairpolicy-new-agent": "bin/fairpolicy-new-agent.js",
    "fairpolicy-license": "bin/fairpolicy-license.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-core"
  },
  "homepage": "https://github.com/fpavia111-creator/fairpolicy-agents/tree/main/packages/fairpolicy-core#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "guardrails",
    "human-in-the-loop",
    "audit-log",
    "fairpolicy",
    "insurance",
    "insurance-agency"
  ]
}
