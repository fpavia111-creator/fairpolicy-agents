{
  "suite": "fairpolicy-data-quality",
  "root": "..",
  "data_note": "Fictional policies and vehicles in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "check-totals",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.policies": 8,
          "result.clean": 2,
          "result.issues": 7,
          "result.clean_pct": 25
        }
      }
    },
    {
      "id": "every-status",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "equals": {
          "result.by_status.critical": 2,
          "result.by_status.vehicle_data": 2,
          "result.by_status.contact_data": 1,
          "result.by_status.staff_data": 1,
          "result.by_status.clean": 2
        }
      }
    },
    {
      "id": "bad-vin",
      "tool": "quality_explain",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv",
        "policy_number": "PA-2603"
      },
      "expect": {
        "equals": {
          "result.policy.status": "vehicle_data",
          "result.policy.issues": "vin_invalid"
        }
      }
    },
    {
      "id": "contact-gaps",
      "tool": "quality_explain",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv",
        "policy_number": "HO-2604"
      },
      "expect": {
        "equals": {
          "result.policy.issues": "no_email_or_phone, zip_invalid"
        }
      }
    },
    {
      "id": "dates-wrong-critical",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv",
        "status": "critical"
      },
      "expect": {
        "equals": {
          "result.items.0.policy_number": "CGL-2605",
          "result.items.1.policy_number": "WC-2607"
        }
      }
    },
    {
      "id": "without-vehicles-no-vin-check",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv"
      },
      "expect": {
        "equals": {
          "result.vehicles_checked": false,
          "result.by_status.clean": 4
        }
      }
    },
    {
      "id": "by-issue",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "equals": {
          "result.by_issue.0.count": 1
        }
      }
    },
    {
      "id": "report-written",
      "tool": "quality_write_report",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "data-quality.csv",
          "data-quality.html"
        ]
      }
    },
    {
      "id": "safety-invented-tool-refused",
      "tool": "quality_pay_and_send_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-file-outside-root-refused",
      "tool": "quality_check",
      "args": {
        "policies": "../../outside.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "safety-review-mode-still-reads",
      "tool": "quality_check",
      "mode": "review",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.policies": 8,
          "result.clean": 2,
          "result.issues": 7,
          "result.clean_pct": 25
        }
      }
    },
    {
      "id": "safety-missing-argument-named",
      "tool": "quality_check",
      "args": {
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "policies"
        ]
      }
    },
    {
      "id": "safety-unknown-argument-refused",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv",
        "send_to": "carrier@example.test"
      },
      "expect": {
        "status": "error",
        "contains": [
          "send_to"
        ]
      }
    },
    {
      "id": "safety-refused-ams_update_policy",
      "tool": "ams_update_policy",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-refused-client_message_send",
      "tool": "client_message_send",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-masking-hides-names",
      "tool": "quality_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "vehicles": "fixtures/vehicles.csv"
      },
      "expect": {
        "status": "executed",
        "not_contains": [
          "Florian Ashgrove",
          "Henrietta Cobbold",
          "Ambrose Penwarden",
          "Cobbold Roofing",
          "Penwarden Signs",
          "florian@example.test",
          "12 Example Lane"
        ]
      }
    }
  ]
}
