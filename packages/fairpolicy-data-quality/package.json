{
  "name": "fairpolicy-data-quality",
  "version": "0.1.0",
  "description": "Checks every active policy for the data that breaks downloads, renewals and certificates: wrong dates, no carrier or premium, missing or invalid VINs, missing address, ZIP or contact, no producer or account manager. Never edits your agency system.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-data-quality": "bin/fairpolicy-data-quality.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-data-quality.js demo",
    "eval": "node bin/fairpolicy-data-quality.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-data-quality"
  },
  "homepage": "https://github.com/fpavia111-creator/fairpolicy-agents/tree/main/packages/fairpolicy-data-quality#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "insurance",
    "insurance-agency",
    "agency-management",
    "fairpolicy",
    "data-quality",
    "vin",
    "agency-management-system",
    "clean-up"
  ]
}
