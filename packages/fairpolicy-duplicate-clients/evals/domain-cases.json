{
  "suite": "fairpolicy-duplicate-clients", "root": "..",
  "data_note": "Fictional client list in ../fixtures. No model is called.",
  "cases": [
    { "id": "check-totals", "tool": "duplicates_check", "args": { "clients": "fixtures/clients.csv" },
      "expect": { "status": "executed", "equals": { "result.clients": 10, "result.pairs": 4, "result.clients_in_duplicates": 6 } } },
    { "id": "every-status", "tool": "duplicates_check", "args": { "clients": "fixtures/clients.csv" },
      "expect": { "equals": { "result.by_status.exact_duplicate": 1, "result.by_status.likely_duplicate": 1, "result.by_status.possible_duplicate": 1, "result.by_status.same_household": 1 } } },
    { "id": "exact-first", "tool": "duplicates_explain", "args": { "clients": "fixtures/clients.csv", "pair": "D-001" },
      "expect": { "equals": { "result.pair.status": "exact_duplicate", "result.pair.shared": "name, e-mail, address" } } },
    { "id": "spelling-and-phone", "tool": "duplicates_explain", "args": { "clients": "fixtures/clients.csv", "pair": "D-002" },
      "expect": { "equals": { "result.pair.status": "likely_duplicate" }, "contains": ["phone"] } },
    { "id": "household-not-merge", "tool": "duplicates_check", "args": { "clients": "fixtures/clients.csv", "status": "same_household" },
      "expect": { "equals": { "result.items.0.shared": "address" } } },
    { "id": "stricter-threshold", "tool": "duplicates_check", "args": { "clients": "fixtures/clients.csv", "threshold": 0.98 },
      "expect": { "equals": { "result.pairs": 3, "result.by_status.exact_duplicate": 1 } } },
    { "id": "unknown-pair", "tool": "duplicates_explain", "args": { "clients": "fixtures/clients.csv", "pair": "D-999" },
      "expect": { "status": "error", "contains": ["not found"] } },
    { "id": "report-written", "tool": "duplicates_write_report", "args": { "clients": "fixtures/clients.csv" },
      "expect": { "status": "executed", "contains": ["duplicate-clients.csv", "duplicate-clients.html"] } }
  ]
}
