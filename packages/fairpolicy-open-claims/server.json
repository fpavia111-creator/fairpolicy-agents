{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairpolicy-open-claims",
  "title": "Fairpolicy Open Claims",
  "description": "Ages open claims: losses with no carrier claim number, claims with no update for weeks, claims…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents",
    "source": "github",
    "subfolder": "packages/fairpolicy-open-claims"
  },
  "websiteUrl": "https://fair-agents.com/fairpolicy.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairpolicy-open-claims",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
