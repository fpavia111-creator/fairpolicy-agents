{
  "suite": "fairpolicy-direct-agency-bill", "root": "..",
  "data_note": "Fictional policies, statement and invoices in ../fixtures. No model is called.",
  "cases": [
    { "id": "check-totals", "tool": "billing_check", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv" },
      "expect": { "status": "executed", "equals": { "result.policies": 7, "result.mismatches": 4, "result.invoiced_at_risk": 5200 } } },
    { "id": "every-status", "tool": "billing_check", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv" },
      "expect": { "equals": { "result.by_status.double_billed": 1, "result.by_status.coded_agency_paid_direct": 1, "result.by_status.coded_direct_invoiced": 1, "result.by_status.bill_type_missing": 1, "result.by_status.ok": 3 } } },
    { "id": "double-billed-first", "tool": "billing_check", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv" },
      "expect": { "equals": { "result.items.0.policy_number": "CGL-8005", "result.items.0.agency_invoiced": 2800, "result.items.0.on_direct_statement": true } } },
    { "id": "coded-agency-paid-direct", "tool": "billing_explain", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv", "policy_number": "BOP-8003" },
      "expect": { "equals": { "result.policy.status": "coded_agency_paid_direct", "result.policy.coded_bill_type": "agency" } } },
    { "id": "coded-direct-invoiced", "tool": "billing_explain", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv", "policy_number": "WC-8004" },
      "expect": { "equals": { "result.policy.status": "coded_direct_invoiced", "result.policy.agency_invoiced": 2400 } } },
    { "id": "expired-left-out", "tool": "billing_check", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv" },
      "expect": { "not_contains": ["PA-8008"] } },
    { "id": "missing-bill-type", "tool": "billing_check", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv", "status": "bill_type_missing" },
      "expect": { "equals": { "result.items.0.policy_number": "UMB-8006" } } },
    { "id": "unknown-policy", "tool": "billing_explain", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv", "policy_number": "XX-1" },
      "expect": { "status": "error", "contains": ["not found"] } },
    { "id": "report-written", "tool": "billing_write_report", "args": { "policies": "fixtures/policies.csv", "statements": "fixtures/direct-bill-statement.csv", "invoices": "fixtures/agency-invoices.csv" },
      "expect": { "status": "executed", "contains": ["direct-agency-bill.csv", "direct-agency-bill.html"] } }
  ]
}
