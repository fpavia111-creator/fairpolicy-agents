{
  "suite": "fairpolicy-signed-declinations",
  "root": "..",
  "data_note": "Fictional policies, documents and checklist in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "check-totals",
      "tool": "declinations_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.policies": 6,
          "result.with_gaps": 4
        }
      }
    },
    {
      "id": "every-status",
      "tool": "declinations_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "equals": {
          "result.by_status.missing": 3,
          "result.by_status.unsigned": 1,
          "result.by_status.complete": 2
        }
      }
    },
    {
      "id": "um-rejection-needed",
      "tool": "declinations_explain",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv",
        "policy_number": "PA-2401"
      },
      "expect": {
        "equals": {
          "result.policy.status": "missing",
          "result.policy.missing": "um_rejection",
          "result.policy.required": "signed_application, um_rejection"
        }
      }
    },
    {
      "id": "declination-needed",
      "tool": "declinations_explain",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv",
        "policy_number": "CGL-2405"
      },
      "expect": {
        "equals": {
          "result.policy.missing": "declination"
        }
      }
    },
    {
      "id": "unsigned-flood-offer",
      "tool": "declinations_explain",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv",
        "policy_number": "HO-2403"
      },
      "expect": {
        "equals": {
          "result.policy.status": "unsigned",
          "result.policy.unsigned": "flood_offer"
        }
      }
    },
    {
      "id": "by-document",
      "tool": "declinations_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "equals": {
          "result.by_document.0.count": 1
        }
      }
    },
    {
      "id": "agency-checklist",
      "tool": "declinations_explain",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv",
        "checklist": "fixtures/checklist.json",
        "policy_number": "WC-2406"
      },
      "expect": {
        "equals": {
          "result.policy.missing": "signed_application, experience_mod_worksheet"
        }
      }
    },
    {
      "id": "expired-left-out",
      "tool": "declinations_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "not_contains": [
          "PA-2407"
        ]
      }
    },
    {
      "id": "report-written",
      "tool": "declinations_write_report",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "signed-declinations.csv",
          "signed-declinations.html"
        ]
      }
    },
    {
      "id": "safety-invented-tool-refused",
      "tool": "declinations_pay_and_send_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-file-outside-root-refused",
      "tool": "declinations_check",
      "args": {
        "policies": "../../outside.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "safety-review-mode-still-reads",
      "tool": "declinations_check",
      "mode": "review",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.policies": 6,
          "result.with_gaps": 4
        }
      }
    },
    {
      "id": "safety-missing-argument-named",
      "tool": "declinations_check",
      "args": {
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "policies"
        ]
      }
    },
    {
      "id": "safety-unknown-argument-refused",
      "tool": "declinations_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv",
        "send_to": "carrier@example.test"
      },
      "expect": {
        "status": "error",
        "contains": [
          "send_to"
        ]
      }
    },
    {
      "id": "safety-refused-esign_request_send",
      "tool": "esign_request_send",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-refused-coverage_recommend",
      "tool": "coverage_recommend",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-masking-hides-names",
      "tool": "declinations_check",
      "args": {
        "policies": "fixtures/policies.csv",
        "documents": "fixtures/documents.csv"
      },
      "expect": {
        "status": "executed",
        "not_contains": [
          "Emeric Valdane",
          "Ottoline Brisbrook",
          "Valdane Ironworks"
        ]
      }
    }
  ]
}
