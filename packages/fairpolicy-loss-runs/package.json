{
  "name": "fairpolicy-loss-runs",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairpolicy-loss-runs",
  "description": "Summarises carrier loss runs by account over five policy years: claims, incurred, loss ratio, large losses and frequency, year by year. Reads the loss runs you have; never requests them or judges a claim.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-loss-runs": "bin/fairpolicy-loss-runs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-loss-runs.js demo",
    "eval": "node bin/fairpolicy-loss-runs.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-loss-runs"
  },
  "homepage": "https://github.com/fpavia111-creator/fairpolicy-agents/tree/master/packages/fairpolicy-loss-runs#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairpolicy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "insurance",
    "insurance-agency",
    "agency-management",
    "fairpolicy",
    "loss-runs",
    "claims-history",
    "loss-ratio",
    "commercial-renewals"
  ]
}
