  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairpolicy-renewal-remarket": "bin/fairpolicy-renewal-remarket.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairpolicy-renewal-remarket.js demo",
    "eval": "node bin/fairpolicy-renewal-remarket.js eval"
  },
  "dependencies": {
    "fairpolicy-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairpolicy-agents.git",
    "directory": "packages/fairpolicy-renewal-remarket"
  },
